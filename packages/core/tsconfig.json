{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": [],
    "verbatimModuleSyntax": true,
    // Internal imports name the file, so Node's type stripping can resolve
    // them when a tool imports this package outside Vite.
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The Effect language service. `effect-tsgo patch` in the root `postinstall`
    // script wires this into `tsc`, so `bun run check:types` reports Effect
    // diagnostics and the editor gets the same quick fixes.
    "plugins": [
      {
        "name": "@effect/language-service",
        // @effect/vitest's test helpers are the documented harness, even
        // though Effect marks them unstable. Allow only those two names.
        "allowedUnstableApis": ["@effect/vitest#it", "@effect/vitest#layer"],
        "diagnosticSeverity": {
          "strictEffectProvide": "warning",
          "preferSchemaOverJson": "warning",
          "floatingEffect": "error",
          "catchAllTagDispatchToCatchTag": "warning",
          "asyncFunction": "warning"
        },
        "ignoreEffectErrorsInTscExitCode": false
      }
    ]
  },
  "include": ["src", "*.ts"]
}
