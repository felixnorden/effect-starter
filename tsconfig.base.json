{
  // Shared compiler options for every package. Each `packages/*/tsconfig.json`
  // extends this file and adds only its `include`. Change the TypeScript setup
  // and the Effect language service options here, once.
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": [],
    "verbatimModuleSyntax": true,
    // Internal imports name the file, so Node's type stripping can resolve
    // them when a tool imports this package outside Vite.
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The Effect language service. `effect-tsgo patch` in the root `postinstall`
    // script wires this into `tsc`, so `bun run check:types` reports Effect
    // diagnostics and the editor gets the same quick fixes. The same options
    // feed the type-aware `oxlint` rules through the root `oxlint.config.ts`.
    "plugins": [
      {
        "name": "@effect/language-service",
        // @effect/vitest's test helpers are the documented harness, even
        // though Effect marks them unstable. Allow only those two names.
        "allowedUnstableApis": ["@effect/vitest#it", "@effect/vitest#layer"],
        "diagnosticSeverity": {
          "abortControllerInEffect": "warning",
          "acquireReleaseDisposable": "warning",
          "allOfMapToForEach": "warning",
          "anyUnknownInErrorContext": "warning",
          "asyncFunction": "warning",
          "catchAllTagDispatchToCatchTag": "warning",
          "catchAllToMapError": "warning",
          "catchChainToFirstSuccessOf": "warning",
          "catchConditionalRefailToCatchIf": "warning",
          "catchDieToOrDie": "warning",
          "catchIfTagToCatchTag": "warning",
          "catchRefailToTapError": "warning",
          "catchTagToCatchReason": "warning",
          "catchToIgnore": "warning",
          "catchToOrElseSucceed": "warning",
          "catchUnfailableEffect": "warning",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "deterministicKeys": "warning",
          "effectDoNotation": "warning",
          "effectFnOpportunity": "warning",
          "effectMapFlatten": "warning",
          "effectMapVoid": "warning",
          "effectSleepZeroToYieldNow": "warning",
          "effectSucceedWithUndefined": "warning",
          "effectSucceedWithVoid": "warning",
          "effectTryWithoutCatch": "warning",
          "errorPayloadShadowsName": "warning",
          "extendsNativeError": "warning",
          "failCauseToConstructor": "warning",
          "flatMapConditionalToFilterOrFail": "warning",
          "flatMapIdentityToFlatten": "warning",
          "flatMapIgnoredParamToAndThen": "warning",
          "flatMapToMap": "warning",
          "flatMapToTap": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalJson": "warning",
          "globalJsonInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "lazyEffect": "warning",
          "leakingRequirements": "warning",
          "manualMetricTapToTrack": "warning",
          "mapConstToAs": "warning",
          "mapMapErrorToMapBoth": "warning",
          "mapSomeCatchNoSuchElement": "warning",
          "mapSomeToAsSome": "warning",
          "matchBooleanToIsSuccess": "warning",
          "matchEffectToMapBoth": "warning",
          "matchEffectToMatch": "warning",
          "matchToResultOrOption": "warning",
          "missedPipeableOpportunity": "warning",
          "missingEffectServiceDependency": "warning",
          "missingPipeableSignature": "warning",
          "multipleCatchTag": "warning",
          "nestedEffectGenYield": "warning",
          "newPromise": "warning",
          "newSchemaClass": "warning",
          "nodeBuiltinImport": "warning",
          "optionMatchToFromOption": "warning",
          "preferBarrelImport": "warning",
          "preferEffectArray": "warning",
          "preferEffectRecord": "warning",
          "preferEffectString": "warning",
          "preferNamespaceImport": "warning",
          "preferSchemaOverJson": "warning",
          "preferSchemaTaggedError": "warning",
          "preferSchemaTypeProperty": "warning",
          "preferSucceedSomeOrNone": "warning",
          "preferTypedSchemaDecoder": "warning",
          "preferUnsafeConstructor": "warning",
          "processEnv": "warning",
          "processEnvInEffect": "warning",
          "provideLayerSucceedToProvideService": "warning",
          "provideMergeAllToArray": "warning",
          "raceFirstWithSleepToTimeout": "warning",
          "redundantMapError": "warning",
          "redundantOrDie": "warning",
          "redundantSchemaTagIdentifier": "warning",
          "resultMatchToFromResult": "warning",
          "returnEffectInGen": "warning",
          "runEffectInsideEffect": "warning",
          "runOfExitToRunExit": "warning",
          "schemaClassMissingBrand": "warning",
          "schemaNumber": "warning",
          "schemaStructWithTag": "warning",
          "schemaSync": "warning",
          "schemaSyncInEffect": "warning",
          "schemaUnionOfLiterals": "warning",
          "serviceNotAsClass": "warning",
          "strictBooleanExpressions": "warning",
          "strictEffectProvide": "warning",
          "suspendFailToFailSync": "warning",
          "syncToSucceed": "warning",
          "timeoutCatchTagToTimeoutOrElse": "warning",
          "tryCatchInEffectGen": "warning",
          "typeUnionToSchemaUnion": "warning",
          "unnecessaryArrowBlock": "warning",
          "unnecessaryEffectGen": "warning",
          "unnecessaryFailYieldableError": "warning",
          "unnecessaryPipe": "warning",
          "unnecessaryPipeChain": "warning",
          "unnecessaryTypeofType": "warning",
          "unsafeEffectTypeAssertion": "warning",
          "yieldInCallArgument": "warning"
        },
        "ignoreEffectErrorsInTscExitCode": false
      }
    ]
  }
}
