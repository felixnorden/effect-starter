{
  "name": "mdv",
  "version": "0.0.0",
  "private": true,
  "description": "A local Markdown viewer: an Effect render core and a thin preview app",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '@mdv/preview' dev",
    "dev:client": "bun run --filter '@mdv/preview' dev:client",
    "build": "bun run --filter '@mdv/preview' build",
    "build:server": "bun scripts/build-editor-server.ts",
    "render": "bun packages/app/src/main.ts render",
    "bench": "bun packages/app/src/bench.ts",
    "fixtures:generate": "bun scripts/generate-fixtures.ts",
    "frames:generate": "bun scripts/generate-editor-frames.ts",
    "config:generate": "bun scripts/generate-config-tables.ts",
    "editor:probe": "bun scripts/editor-probe.ts",
    "editor:conformance": "bun scripts/editor-conformance.ts",
    "editor:sessions": "bun scripts/editor-sessions.ts",
    "editor:lifecycle": "bun scripts/editor-lifecycle.ts",
    "editor:refresh": "bun scripts/editor-refresh.ts",
    "editor:bench": "bun scripts/editor-bench.ts",
    "editor:bench:installed": "bun scripts/editor-bench-installed.ts",
    "check:pointers": "bun scripts/check-requirements-pointers.ts",
    "check": "oxlint . && oxfmt --check . && bun run --workspaces check:types && bun run test",
    "check:types": "bun run --workspaces check:types",
    "test": "bun run --workspaces --if-present test",
    "patch:tsgo": "effect-tsgo patch --typescript --oxlint",
    "postinstall": "bun run patch:tsgo",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "clean": "rm -rf packages/*/dist",
    "skills:sync": "skills experimental_install -y",
    "skills:check": "bun scripts/check-skills.mjs",
    "preview": "bun packages/app/src/main.ts preview",
    "bench:browser": "bun run --filter '@mdv/preview' bench:browser",
    "check:a11y": "bun run --filter '@mdv/preview' check:a11y",
    "themes:generate": "bun scripts/generate-theme-sheets.ts",
    "editor:health": "bun scripts/editor-health.ts",
    "editor:protocol": "bun scripts/editor-protocol.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "effect": "catalog:",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "shiki": "catalog:",
    "skills": "1.7.0",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.20.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.57.0",
    "@effect/vitest": "4.0.6",
    "effect": "4.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.5",
    "hast-util-from-html": "2.0.3",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "markdown-it": "15.0.3",
    "shiki": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "daisyui": "5.7.50",
    "yaml": "2.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "@types/bun": "1.4.4",
    "@playwright/test": "1.64.1",
    "@mdit/plugin-katex": "1.1.4",
    "katex": "0.19.1",
    "@mdit/plugin-footnote": "1.1.3",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "@types/markdown-it-emoji": "3.0.1",
    "@axe-core/playwright": "4.14.0"
  }
}
